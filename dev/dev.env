# Environnement de DÉVELOPPEMENT, branché sur le faux GitLab (`make dev-gitlab`).
# Ce fichier est versionné : il ne contient aucun vrai secret. Ne jamais l'utiliser en production.

APP_ENV=dev
APP_BASE_URL=http://127.0.0.1:8000
# Le serveur de développement du frontend (Vite) appelle l'API depuis ces adresses.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false
SESSION_SECRET=secret-de-session-de-dev-sans-valeur-0123456789

GITLAB_URL=http://127.0.0.1:8001
GITLAB_PROJECT=arthur.jeaugey/5-nights-at-epita
GITLAB_TOKEN=jeton-de-dev
GITLAB_OAUTH_CLIENT_ID=carnet-dev
GITLAB_OAUTH_CLIENT_SECRET=secret-oauth-de-dev
GITLAB_WEBHOOK_SECRET=secret-webhook-de-dev

PROJECT_CONFIG=config/projet.toml
FRONTEND_DIST=frontend/dist
DATA_DIR=data

# Rythmes resserrés pour voir les changements sans attendre : interrogation toutes les 3 s,
# relecture complète toutes les 15 s (elle rattrape un `POST /_dev/reset` du faux GitLab),
# et retour à l'interrogation 20 s après le dernier webhook.
POLL_INTERVAL_SECONDS=3
FULL_REFRESH_SECONDS=15
WEBHOOK_FRESH_SECONDS=20
LOG_LEVEL=INFO

# Les appels vers le faux GitLab ne doivent pas passer par un proxy sortant.
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
