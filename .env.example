# Modèle de configuration. Copier ce fichier vers `.env` et remplir les valeurs.
# `.env` contient des secrets : il est ignoré par Git et ne doit jamais être partagé.
# Les réglages non secrets (calendrier, membres, labels, seuils) sont dans config/projet.toml.

# --- Application ------------------------------------------------------------------------------

# « prod » sur le serveur. « dev » active la documentation de l'API et assouplit la connexion locale.
APP_ENV=prod

# Adresse publique du tableau de bord, sans barre oblique finale. Elle sert d'adresse de retour
# pour la connexion GitLab et de référence pour refuser les requêtes venues d'un autre site.
APP_BASE_URL=https://carnet.exemple.fr

# Clé de signature des sessions, au moins 32 caractères. La changer déconnecte tout le monde.
# Générer avec :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- GitLab -----------------------------------------------------------------------------------

# Adresse de l'instance GitLab, sans barre oblique finale.
GITLAB_URL=https://gitlab.cri.epita.fr

# Projet du jeu : son chemin complet, ou son identifiant numérique.
GITLAB_PROJECT=arthur.jeaugey/5-nights-at-epita

# Token d'accès DU PROJET (Settings → Access tokens), rôle Reporter.
# Phase 1 (lecture seule) : portée « read_api ». À partir de la phase 2 (actions) : portée « api ».
GITLAB_TOKEN=

# Application OAuth pour la connexion des membres. À créer dans GitLab :
# avatar → Edit profile → Applications → Add new application
#   Redirect URI : <APP_BASE_URL>/auth/callback
#   Confidential : coché            Scopes : openid uniquement
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Webhook du projet (Settings → Webhooks), URL : <APP_BASE_URL>/hooks/gitlab
# Événements : Issues, Merge requests, Comments, Pipelines, Push, Tag push, Milestones.
# Remplir au moins l'une des deux lignes ; sans aucune des deux, tous les webhooks sont refusés
# et le tableau de bord se contente d'interroger GitLab régulièrement.
#   - « Secret token » du webhook (en-tête X-Gitlab-Token)
#     Générer avec :  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GITLAB_WEBHOOK_SECRET=
#   - « Signing token » du webhook (signature HMAC, GitLab 19 ou plus ; commence par whsec_)
GITLAB_WEBHOOK_SIGNING_TOKEN=

# Niveau d'accès minimal au projet pour entrer dans le tableau de bord (10 = Guest, 30 = Developer).
# GITLAB_MIN_ACCESS_LEVEL=10

# --- Exposition -------------------------------------------------------------------------------

# Jeton du tunnel Cloudflare (Zero Trust → Networks → Tunnels → créer un tunnel « cloudflared »).
# Le nom d'hôte public du tunnel doit pointer vers  http://app:8000
CLOUDFLARE_TUNNEL_TOKEN=

# Port local sur lequel l'application reste joignable depuis la machine (127.0.0.1 uniquement).
# APP_PORT=8000

# --- Réglages facultatifs ---------------------------------------------------------------------

# Les cookies de session ne voyagent qu'en HTTPS. Ne mettre « false » qu'en développement local.
# COOKIE_SECURE=true

# Origines supplémentaires autorisées à modifier des données, séparées par des virgules.
# ALLOWED_ORIGINS=

# Secondes entre deux interrogations de GitLab quand les webhooks n'arrivent pas.
# POLL_INTERVAL_SECONDS=30
# Secondes entre deux relectures complètes, qui corrigent tout signal manqué.
# FULL_REFRESH_SECONDS=600
# Durée, en secondes, pendant laquelle un webhook reçu suspend l'interrogation périodique.
# WEBHOOK_FRESH_SECONDS=3600
# Secondes avant de revérifier qu'une personne connectée est toujours membre du projet.
# MEMBERSHIP_RECHECK_SECONDS=600

# Chemins, à ne changer que hors Docker.
# PROJECT_CONFIG=config/projet.toml
# FRONTEND_DIST=frontend/dist
# DATA_DIR=data

# LOG_LEVEL=INFO
